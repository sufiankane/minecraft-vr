{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC x64 (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-ci",
      "displayName": "Linux CI (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-ci",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux ASan/UBSan (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-asan",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux TSan (Ninja)",
      "description": "GCC 13's libstdc++ emits -Wtsan for every std::atomic_thread_fence under -fsanitize=thread and the repo builds with -Werror. TSan does not instrument fences; the fence-based seqlock protocol is deliberate and sound, so -Wno-tsan (right after -fsanitize=thread) disables only that diagnostic; the later generic -Werror does not re-enable a disabled warning.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-tsan",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -Wno-tsan -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-coverage",
      "displayName": "Linux coverage (Ninja, gcov)",
      "description": "gcov's default -fprofile-update=single is not thread-safe; the ThreadSafety stress tests run in this build, so concurrent counter writes can corrupt .gcda data (gcovr NegativeHits parse errors). -fprofile-update=atomic makes the profile counters thread-safe.",
      "inherits": "linux-ci",
      "binaryDir": "${sourceDir}/build/linux-coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O0 -g --coverage -fprofile-update=atomic",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "benchmarks",
      "displayName": "Benchmarks (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/benchmarks",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CG_BUILD_BENCHMARKS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc"
    },
    {
      "name": "linux-ci",
      "configurePreset": "linux-ci"
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan"
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan"
    },
    {
      "name": "linux-coverage",
      "configurePreset": "linux-coverage"
    },
    {
      "name": "benchmarks",
      "configurePreset": "benchmarks"
    }
  ],
  "testPresets": [
    {
      "name": "ci",
      "configurePreset": "windows-msvc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-ci",
      "configurePreset": "linux-ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-coverage",
      "configurePreset": "linux-coverage",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "benchmarks",
      "configurePreset": "benchmarks",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
