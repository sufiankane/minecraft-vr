* text=auto
*.sh text eol=lf
*.ps1 text eol=crlf
*.cs text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.pgm -text
data/** -text
# Unity rewrites ProjectSettings assets with CRLF; pin the working-tree EOL so
# `git status` stops showing empty-diff modifications after Unity runs.
unity/Cubeglass/ProjectSettings/*.asset text eol=crlf
