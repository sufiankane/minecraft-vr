root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Windows scripts keep CRLF, matching .gitattributes.
[*.{ps1,cmd,bat}]
end_of_line = crlf

[*.cs]
indent_size = 4
# Style suggestions only: TreatWarningsAsErrors is enabled in Directory.Build.props,
# so nothing here may be promoted to a warning or error.
csharp_style_namespace_declarations = block_scoped:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_diagnostic.IDE0005.severity = suggestion
dotnet_diagnostic.IDE0055.severity = suggestion

# Indentation mirrors .clang-format (LLVM base, IndentWidth 4, ColumnLimit 120).
[*.{cpp,cc,cxx,hpp,hh,hxx,h}]
indent_size = 4

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2
