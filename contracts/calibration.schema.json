{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubeglass.dev/contracts/calibration.schema.json",
  "title": "Cubeglass calibration file (dossier 5.7)",
  "type": "object",
  "required": [
    "schema",
    "device_serial",
    "created_utc",
    "rig",
    "head_from_left_camera",
    "hand_profile",
    "quality"
  ],
  "properties": {
    "schema": { "const": 1 },
    "device_serial": { "type": "string" },
    "created_utc": { "type": "string" },
    "rig": {
      "type": "object",
      "required": ["image_size", "left", "right", "right_from_left"],
      "properties": {
        "image_size": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 1 }
        },
        "left": { "$ref": "#/$defs/camera" },
        "right": { "$ref": "#/$defs/camera" },
        "right_from_left": { "$ref": "#/$defs/pose" }
      },
      "additionalProperties": false
    },
    "head_from_left_camera": { "$ref": "#/$defs/pose" },
    "hand_profile": {
      "type": "object",
      "required": ["bone_lengths_m", "tolerance"],
      "properties": {
        "bone_lengths_m": { "type": "array", "items": { "type": "number", "minimum": 0 } },
        "tolerance": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": ["reproj_rms_px", "n_views"],
      "properties": {
        "reproj_rms_px": { "type": "number", "minimum": 0 },
        "n_views": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "camera": {
      "type": "object",
      "required": ["model", "fx", "fy", "cx", "cy", "dist"],
      "properties": {
        "model": { "enum": ["fisheye", "pinhole"] },
        "fx": { "type": "number", "exclusiveMinimum": 0 },
        "fy": { "type": "number", "exclusiveMinimum": 0 },
        "cx": { "type": "number" },
        "cy": { "type": "number" },
        "dist": { "type": "array", "items": { "type": "number" } }
      },
      "additionalProperties": false
    },
    "pose": {
      "type": "object",
      "required": ["p", "q"],
      "properties": {
        "p": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "q": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        }
      },
      "additionalProperties": false
    }
  }
}
